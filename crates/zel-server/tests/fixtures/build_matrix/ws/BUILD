load("@rules_shell//shell:sh_binary.bzl","sh_binary")
load("@rules_shell//shell:sh_test.bzl","sh_test")
load("@rules_shell//shell:sh_library.bzl","sh_library")
genrule(name="gen", outs=["g.txt"], cmd="echo hi > $@")
genrule(name="gen2", srcs=["g.txt"], outs=["m1.txt"], cmd="cat $(location g.txt) > $(location m1.txt)")
genrule(name="gen3", outs=["m3.txt"], cmd="echo x > $(location m3.txt)")
genrule(name="bad", outs=["b.txt"], cmd="echo oops >&2; exit 1")
sh_binary(name="bin", srcs=["bin.sh"])
sh_binary(name="bin2", srcs=["bin.sh"])
sh_library(name="lib", srcs=["lib.sh"])
sh_test(name="pass", srcs=["pass.sh"], deps=[":lib"])
sh_test(name="fail", srcs=["fail.sh"])
sh_test(name="flaky", srcs=["flaky.sh"], flaky=True)
sh_test(name="slow", srcs=["slow.sh"], timeout="short")
sh_test(name="shard", srcs=["pass.sh"], shard_count=2)
sh_test(name="envt", srcs=["env.sh"])
sh_test(name="man", srcs=["pass.sh"], tags=["manual"])
test_suite(name="suite", tests=[":pass",":fail"])
sh_test(name="crash", srcs=["crash.sh"])
sh_test(name="large", srcs=["pass.sh"], size="large")
sh_test(name="small_t", srcs=["pass.sh"], size="small", tags=["tagA"])
sh_test(name="multi", srcs=["multi.sh"])
genrule(name="noout", outs=["n.txt"], cmd="true")
genrule(name="missingin", srcs=["nofile.txt"], outs=["mi.txt"], cmd="cat $(SRCS) > $@")
genrule(name="cyc1", srcs=[":cyc2"], outs=["cy1.txt"], cmd="true")
genrule(name="cyc2", srcs=[":cyc1"], outs=["cy2.txt"], cmd="true")
genrule(name="anerr", outs=["ae.txt"], cmd="$(location //nonexist:x)")
genrule(name="privuse", srcs=["//priv:secret"], outs=["pu.txt"], cmd="cat $(SRCS) > $@")
