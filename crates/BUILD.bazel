# `zel-bazel-tools` embeds Bazel's //tools and builtins_bzl. Cargo does this from build.rs; here
# the same `files.rs` table is generated by a genrule (include_bytes! paths are made relative to
# the generated file by counting the components of $(RULEDIR)).
genrule(
    name = "zel_bazel_tools_files",
    srcs = glob([
        "zel-bazel-tools/resources/**",
        "zel-bazel-tools/builtins/**",
    ]),
    outs = ["zel-bazel-tools/gen/files.rs"],
    cmd = """
set -e
depth=$$(echo "$(RULEDIR)/zel-bazel-tools/gen" | tr '/' '\\n' | grep -c .)
up=""; i=0; while [ $$i -lt $$depth ]; do up="$$up../"; i=$$((i+1)); done
emit() {
  echo "pub static $$1: &[(&str, &[u8])] = &["
  for f in $$(echo "$(SRCS)" | tr ' ' '\\n' | grep "/$$2/" | LC_ALL=C sort); do
    rel=$${f#*zel-bazel-tools/$$2/}
    echo "    (\\"$$rel\\", include_bytes!(\\"$$up$$f\\")),"
  done
  echo "];"
}
{ emit FILES resources; emit BUILTINS builtins; } > $@
""",
)

rust_library(
    name = "zel_bazel_tools",
    srcs = glob(["zel-bazel-tools/src/**/*.rs"]),
    compile_data = [":zel_bazel_tools_files"] + glob([
        "zel-bazel-tools/resources/**",
        "zel-bazel-tools/builtins/**",
    ]),
    crate_name = "zel_bazel_tools",
    edition = "2021",
    rustc_env = {"OUT_DIR": "${pwd}/$(RULEDIR)/zel-bazel-tools/gen"},
)

rust_test(
    name = "zel_bazel_tools_test",
    crate = ":zel_bazel_tools",
)

