digraph mygraph {
  node [shape=box];
  "//a:gg"
  "//a:gg" -> "//a:sel"
  "//a:gg" -> "@bazel_tools//tools/genrule:genrule-setup.sh"
  "//a:gg" -> "@ext//lib:data"
  "//a:gg" -> "//b:tool"
  "//b:tool"
  "//b:tool" -> "//b:tool.cc"
  "//b:tool.cc"
  "@bazel_tools//tools/genrule:genrule-setup.sh"
  "//a:sel"
  "//a:sel" -> "//a:opt_cs\n...and 4 more items"
  [label="//conditions:default//a:def_cs//a:opt_cs"];
  "//a:opt_cs\n...and 4 more items"
  "@ext//lib:data"
  "@ext//lib:data" -> "@ext//lib:d.txt"
  "@ext//lib:d.txt"
}
