<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<query version="2">
    <rule class="filegroup" location="@WS@/c/BUILD:1:10" name="//c:cdata">
        <string name="name" value="cdata"/>
        <list name="visibility">
            <label value="//visibility:public"/>
        </list>
        <list name="srcs">
            <label value="//c:d.txt"/>
        </list>
        <rule-input name="//c:d.txt"/>
    </rule>
    <source-file location="@WS@/c/d.txt:1:1" name="//c:d.txt">
        <visibility-label name="//visibility:private"/>
    </source-file>
    <rule class="filegroup" location="@WS@/d/BUILD:2:10" name="//d:ok">
        <string name="name" value="ok"/>
        <list name="srcs">
            <label value="//c:cdata"/>
        </list>
        <rule-input name="//c:cdata"/>
    </rule>
</query>
