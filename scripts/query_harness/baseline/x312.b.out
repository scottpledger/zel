<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<query version="2">
    <rule class="catrule" location="@WS@/a/BUILD:4:8" name="//a:lib">
        <string name="name" value="lib"/>
        <list name="tags">
            <string value="fast"/>
            <string value="manual"/>
        </list>
        <list name="srcs">
            <label value="//a:x.txt"/>
            <label value="//a:srcs_fg"/>
            <label value="@ext//lib:data"/>
        </list>
        <string name="tag_x" value="lib"/>
        <rule-input name="//a:srcs_fg"/>
        <rule-input name="//a:x.txt"/>
        <rule-input name="@ext//lib:data"/>
    </rule>
    <rule class="catrule" location="@WS@/a/BUILD:5:8" name="//a:lib2">
        <string name="name" value="lib2"/>
        <list name="tags">
            <string value="fast"/>
        </list>
        <list name="srcs">
            <label value="//a:lib"/>
            <label value="//a:y.txt"/>
        </list>
        <rule-input name="//a:lib"/>
        <rule-input name="//a:y.txt"/>
    </rule>
    <rule class="filegroup" location="@WS@/a/BUILD:3:10" name="//a:srcs_fg">
        <string name="name" value="srcs_fg"/>
        <list name="srcs">
            <label value="//a:x.txt"/>
            <label value="//a:y.txt"/>
            <label value="//a:z.txt"/>
        </list>
        <rule-input name="//a:x.txt"/>
        <rule-input name="//a:y.txt"/>
        <rule-input name="//a:z.txt"/>
    </rule>
    <source-file location="@WS@/a/x.txt:1:1" name="//a:x.txt">
        <visibility-label name="//visibility:public"/>
    </source-file>
    <source-file location="@WS@/a/y.txt:1:1" name="//a:y.txt">
        <visibility-label name="//visibility:public"/>
    </source-file>
    <source-file location="@WS@/a/z.txt:1:1" name="//a:z.txt">
        <visibility-label name="//visibility:public"/>
    </source-file>
    <source-file location="@WS@/b/t.cc:1:1" name="//b:t.cc">
        <visibility-label name="//visibility:private"/>
    </source-file>
    <rule class="x_test" location="@WS@/b/BUILD:3:7" name="//b:t1">
        <string name="name" value="t1"/>
        <list name="tags">
            <string value="fast"/>
        </list>
        <string name="size" value="small"/>
        <list name="srcs">
            <label value="//b:t.cc"/>
        </list>
        <list name="data">
            <label value="//a:lib2"/>
        </list>
        <rule-input name="//a:lib2"/>
        <rule-input name="//b:t.cc"/>
    </rule>
    <source-file location="@OB@/external/ext+/lib/d.txt:1:1" name="@ext//lib:d.txt">
        <visibility-label name="//visibility:private"/>
    </source-file>
    <rule class="filegroup" location="@OB@/external/ext+/lib/BUILD:1:10" name="@ext//lib:data">
        <string name="name" value="data"/>
        <list name="visibility">
            <label value="//visibility:public"/>
        </list>
        <list name="srcs">
            <label value="@ext//lib:d.txt"/>
        </list>
        <rule-input name="@ext//lib:d.txt"/>
    </rule>
</query>
