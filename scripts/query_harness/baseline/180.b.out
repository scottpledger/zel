digraph mygraph {
  node [shape=box];
  "//a:gg"
  "//a:gg" -> "//a:sel"
  "//a:gg" -> "//b:tool"
  "//a:gg" -> "@ext//lib:data"
  "//a:gg" -> "@bazel_tools//tools/genrule:genrule-setup.sh"
  "//a:sel"
  "//a:sel" -> "//a:def_cs\n//a:x.txt\n//a:y.txt\n//a:opt_cs\n//a:z.txt"
  [label="//a:opt_cs//a:def_cs//conditions:default"];
  "//a:def_cs\n//a:x.txt\n//a:y.txt\n//a:opt_cs\n//a:z.txt"
  "//b:tool"
  "//b:tool" -> "//b:tool.cc"
  "@ext//lib:data"
  "@ext//lib:data" -> "@ext//lib:d.txt"
  "@bazel_tools//tools/genrule:genrule-setup.sh"
  "//b:tool.cc"
  "@ext//lib:d.txt"
}
