<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<query version="2">
    <rule class="catrule" location="@WS@/a/BUILD:5:8" name="//a:lib2">
        <string name="name" value="lib2"/>
        <list name="tags">
            <string value="fast"/>
        </list>
        <list name="srcs">
            <label value="//a:lib"/>
            <label value="//a:y.txt"/>
        </list>
        <rule-input name="//a:lib"/>
        <rule-input name="//a:y.txt"/>
    </rule>
    <rule class="trule" location="@WS@/a/BUILD:8:6" name="//a:tr">
        <string name="name" value="tr"/>
        <label name="dep" value="//a:lib"/>
        <rule-input name="//a:lib"/>
        <rule-input name="@bazel_tools//tools/allowlists/function_transition_allowlist:function_transition_allowlist"/>
    </rule>
</query>
