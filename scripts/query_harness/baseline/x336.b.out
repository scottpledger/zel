        <list name="tools">
            <label value="//b:tool"/>
        </list>
        <list name="outs">
            <output value="//a:gg.out"/>
        </list>
        <string name="cmd" value="cat $(SRCS) &gt; $@ ; echo $(location :sel) &gt;&gt; $@"/>
        <string name="cmd_bash" value=""/>
        <string name="cmd_bat" value=""/>
        <string name="cmd_ps" value=""/>
        <boolean name="output_to_bindir" value="false"/>
