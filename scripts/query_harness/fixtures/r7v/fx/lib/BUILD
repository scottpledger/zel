load("//:rules.bzl", "cat", "lm", "sm", "wr")
package(default_visibility = ["//app:__subpackages__"], default_testonly = False)
cat(name = "l1", srcs = ["a.txt", "b.txt"], k = "one", m = {"x": "1", "y": "2"}, tags = ["t1", "t2"])
cat(name = "l2", srcs = [":l1", "//data:d"], opts = ["z"], n = 7, flag = True, visibility = ["//visibility:public"])
cat(name = "l3", srcs = [":l2", ":l1"], tool = "//tools:t", tags = ["t2"])
wr(name = "w1", text = "hello", deps = [":l1"])
lm(name = "mac_l", n = 3, tags = ["fromlm"])
sm(name = "smac", srcs = ["a.txt"])
filegroup(name = "fg", srcs = glob(["*.txt"], exclude = ["b.txt"]), data = [":l3"])
genrule(name = "gr", srcs = ["a.txt"], outs = ["gr.out", "gr2.out"], cmd = "cp $< $(@D)/gr.out; cp $< $(@D)/gr2.out", tools = ["//tools:t"], tags = ["gen"], testonly = True)
genrule(name = "gr_loc", srcs = ["a.txt"], outs = ["grl.out"], cmd = "echo $(location :l1) $(execpath //tools:t) > $@", tools = [":l1", "//tools:t"])
