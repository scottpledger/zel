load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("//:rules.bzl", "cat")
package(default_visibility = ["//visibility:public"])
sh_binary(name = "t", srcs = ["t.sh"], data = ["conf.txt"])
sh_test(name = "t_test", srcs = ["t.sh"], data = [":t"], size = "small", tags = ["fast", "unit"])
sh_test(name = "t_test2", srcs = ["t.sh"], timeout = "long", tags = ["slow", "manual"], flaky = True)
sh_library(name = "shl", srcs = ["t.sh"], deps = [":sh2"])
sh_library(name = "sh2", srcs = ["t.sh"], deps = [":shl"])
test_suite(name = "ts", tests = [":t_test", ":t_test2"])
test_suite(name = "ts_fast", tags = ["fast"])
test_suite(name = "ts_nested", tests = [":ts", "//app:app_test"])
test_suite(name = "ts_all")
