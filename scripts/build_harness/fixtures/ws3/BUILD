load("@rules_shell//shell:sh_binary.bzl","sh_binary")
load("@rules_shell//shell:sh_test.bzl","sh_test")
load("@rules_shell//shell:sh_library.bzl","sh_library")
genrule(name="ga", outs=["ga.txt"], cmd="echo A > $@")
genrule(name="gb", srcs=[":ga"], outs=["sub/dir/gb.txt"], cmd="cat $< > $@; echo B >> $@")
genrule(name="gc", srcs=[":ga",":gb"], outs=["gc1.txt","gc2.txt"], cmd="cat $(SRCS) > $(location gc1.txt); echo c2 > $(location gc2.txt)")
genrule(name="gfail", outs=["gf.txt"], cmd="echo oops >&2; exit 9")
genrule(name="gfail_big", outs=["gfb.txt"], cmd="head -c 6000 /dev/zero | tr '\\0' x >&2; exit 2")
genrule(name="gwarn", outs=["gw.txt"], cmd="echo careful >&2; echo ok > $@")
genrule(name="gout", outs=["go.txt"], cmd="echo to-stdout; echo ok > $@")
genrule(name="gstamp", outs=["gst.txt"], cmd="grep -c . $(INFO_FILE) >/dev/null; grep -c . $(VERSION_FILE) >/dev/null; echo st > $@", stamp=1)
genrule(name="gexe", outs=["gx.sh"], cmd="echo '#!/bin/sh' > $@; echo 'echo gexe-ran \"$$@\"' >> $@", executable=True)
genrule(name="gmiss", outs=["gm1.txt","gm2.txt"], cmd="echo 1 > $(location gm1.txt)")
genrule(name="gtoolu", outs=["gtu.txt"], cmd="$(location :hello) > $@", tools=[":hello"])
genrule(name="gcycx", srcs=[":gcycy"], outs=["cx.txt"], cmd="true")
genrule(name="gcycy", srcs=[":gcycx"], outs=["cy.txt"], cmd="true")
genrule(name="gbadsrc", srcs=["//nope:file"], outs=["bs.txt"], cmd="true")
sh_binary(name="hello", srcs=["hello.sh"], data=["data.txt"])
sh_binary(name="cat_in", srcs=["cat_in.sh"])
sh_binary(name="exit5", srcs=["exit5.sh"])
sh_binary(name="envdump", srcs=["envdump.sh"], env={"RULE_ENV":"re"})
sh_library(name="lib", srcs=["data.txt"])
sh_test(name="tp", srcs=["tp.sh"])
sh_test(name="tf", srcs=["tf.sh"])
sh_test(name="tf2", srcs=["tf.sh"])
sh_test(name="tfl", srcs=["tfl.sh"])
sh_test(name="tstd", srcs=["tstd.sh"])
sh_test(name="tcov", srcs=["tcov.sh"], data=["data.txt"])
sh_test(name="tflaky", srcs=["t_flaky.sh"], flaky=True)
sh_test(name="tflaky_noattr", srcs=["t_flaky.sh"])
sh_test(name="tslow", srcs=["tslow.sh"], timeout="short")
sh_test(name="tsmall", srcs=["tp.sh"], size="small", tags=["fast"])
sh_test(name="tlarge", srcs=["tp.sh"], size="large", tags=["slowish"])
sh_test(name="tman", srcs=["tp.sh"], tags=["manual"])
sh_test(name="tshard", srcs=["tshard.sh"], shard_count=2)
sh_test(name="tenv", srcs=["tenv.sh"], env={"E1":"v1"})
sh_test(name="targs", srcs=["targs.sh"], args=["x","y"])
sh_test(name="tbigout", srcs=["tbig.sh"])
test_suite(name="suite_ok", tests=[":tp",":tsmall"])
test_suite(name="suite_mixed", tests=[":tp",":tf"])
test_suite(name="suite_tag", tags=["fast"])
test_suite(name="suite_empty", tests=[])
filegroup(name="fg", srcs=[":ga",":gb"], output_group="gen")
filegroup(name="fgsrc", srcs=["data.txt","hello.sh"])
sh_test(name="tcov2", srcs=["tcov2.sh"])
