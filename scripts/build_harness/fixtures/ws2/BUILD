load("@rules_shell//shell:sh_binary.bzl","sh_binary")
load("@rules_shell//shell:sh_test.bzl","sh_test")
load("@rules_shell//shell:sh_library.bzl","sh_library")
genrule(name="g1", outs=["g1.out"], cmd="echo one > $@")
genrule(name="g2", srcs=[":g1"], outs=["g2.out"], cmd="cat $< > $@; echo two >> $@")
genrule(name="g3", srcs=[":g2",":g1"], outs=["g3.out","g3b.out"], cmd="cat $(SRCS) > $(location g3.out); echo b > $(location g3b.out)")
genrule(name="gfail", outs=["gf.out"], cmd="echo boom >&2; exit 3")
genrule(name="gfail2", srcs=[":g1"], outs=["gf2.out"], cmd="exit 4")
genrule(name="gpartial", outs=["p1.out","p2.out"], cmd="echo x > $(location p1.out)")
genrule(name="gtool", outs=["gt.out"], cmd="$(location :tool) > $@", tools=[":tool"])
genrule(name="gexec", outs=["ge.out"], cmd="echo exec > $@", executable=True)
genrule(name="gstamp", outs=["gs.out"], cmd="cat $(INFO_FILE) $(VERSION_FILE) | head -c0; echo s > $@", stamp=1)
genrule(name="gmake", outs=["gm.out"], cmd="echo $(COMPILATION_MODE) $(BINDIR)| sed 's/[a-z0-9_-]*-out/X/' > $@")
genrule(name="gbadvar", outs=["gv.out"], cmd="echo $(NOSUCHVAR) > $@")
genrule(name="gbadloc", outs=["gl.out"], cmd="echo $(location :nosuch) > $@")
genrule(name="gnoout", outs=["gno.out"], cmd="true")
genrule(name="gcyc_a", srcs=[":gcyc_b"], outs=["ca.out"], cmd="true")
genrule(name="gcyc_b", srcs=[":gcyc_c"], outs=["cb.out"], cmd="true")
genrule(name="gcyc_c", srcs=[":gcyc_a"], outs=["cc.out"], cmd="true")
genrule(name="gslow", outs=["gslow.out"], cmd="sleep 1; echo s > $@")
genrule(name="gstderr", outs=["gse.out"], cmd="echo warn >&2; echo ok > $@")
genrule(name="gstdout", outs=["gso.out"], cmd="echo hello-stdout; echo ok > $@")
genrule(name="glocal", outs=["gloc.out"], cmd="echo l > $@", local=True)
genrule(name="gtag", outs=["gtag.out"], cmd="echo l > $@", tags=["manual","foo"])
genrule(name="gtimeout", outs=["gto.out"], cmd="echo t > $@", tags=["no-sandbox"])
genrule(name="gdepvis", srcs=["//vis:private_file"], outs=["gdv.out"], cmd="cat $< > $@")
genrule(name="gdepdeprecated", srcs=["//vis:dep"], outs=["gdd.out"], cmd="cat $< > $@")
genrule(name="gmissing", srcs=["nonexistent.txt"], outs=["gmi.out"], cmd="cat $< > $@")
genrule(name="gdir", outs=["gdir_out"], cmd="mkdir $@; echo a > $@/a", output_to_bindir=1)
sh_binary(name="tool", srcs=["tool.sh"])
sh_binary(name="args", srcs=["args.sh"], data=["data.txt"], args=["--builtin"], env={"BIN_ENV":"fromrule"})
sh_binary(name="exit7", srcs=["exit7.sh"])
sh_binary(name="pwd", srcs=["pwd.sh"])
sh_library(name="slib", srcs=["slib.sh"], data=["data.txt"])
sh_test(name="t_pass", srcs=["t_pass.sh"])
sh_test(name="t_fail", srcs=["t_fail.sh"])
sh_test(name="t_out", srcs=["t_out.sh"])
sh_test(name="t_env", srcs=["t_env.sh"], env={"FROM_RULE":"1"}, env_inherit=["HOME"])
sh_test(name="t_args", srcs=["t_args.sh"], args=["a1","a2"])
sh_test(name="t_data", srcs=["t_data.sh"], data=["data.txt"])
sh_test(name="t_slow", srcs=["t_slow.sh"], timeout="short")
sh_test(name="t_med", srcs=["t_pass.sh"], size="medium", tags=["tagB","exclusive"])
sh_test(name="t_enorm", srcs=["t_pass.sh"], size="enormous")
sh_test(name="t_small", srcs=["t_pass.sh"], size="small", tags=["tagA"])
sh_test(name="t_flaky_pass", srcs=["t_flaky.sh"], flaky=True)
sh_test(name="t_shard", srcs=["t_shard.sh"], shard_count=3)
sh_test(name="t_manual", srcs=["t_pass.sh"], tags=["manual"])
sh_test(name="t_local", srcs=["t_pass.sh"], local=True)
sh_test(name="t_notcached", srcs=["t_pass.sh"], tags=["external"])
sh_test(name="t_noexit", srcs=["t_noexit.sh"])
sh_test(name="t_stderr", srcs=["t_stderr.sh"])
sh_test(name="t_big", srcs=["t_big.sh"])
sh_test(name="t_xml", srcs=["t_xml.sh"])
sh_test(name="t_undecl", srcs=["t_undecl.sh"])
sh_test(name="t_sleep_ok", srcs=["t_sleep.sh"], timeout="moderate")
test_suite(name="s_all", tests=[":t_pass",":t_fail",":t_out"])
test_suite(name="s_tag", tags=["tagA"])
test_suite(name="s_nested", tests=[":s_all",":t_small"])
test_suite(name="s_empty", tests=[])
test_suite(name="s_manual", tests=[":t_manual"])
sh_test(name="t_crash", srcs=["t_crash.sh"])
sh_test(name="t_nonexec", srcs=["t_nonexec.sh"])
sh_test(name="t_plain", srcs=["t_pass.sh"], env={"A":"1"})
sh_test(name="t_exit_ok_big_args", srcs=["t_pass.sh"], args=["$(location data.txt)"], data=["data.txt"])
