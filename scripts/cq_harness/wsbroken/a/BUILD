load("//:defs.bzl","catrule","smacro","lmacro","trule","xlib")
package(default_visibility=["//visibility:public"])
filegroup(name="srcs_fg", srcs=glob(["*.txt"]))
catrule(name="lib", srcs=["x.txt","//a:srcs_fg", "@ext//lib:data"], tag_x="lib", tags=["manual","fast"])
catrule(name="lib2", srcs=[":lib","y.txt"], tags=["fast"])
smacro(name="sm", srcs=["x.txt","y.txt"])
lmacro(name="lm", tags=["fast"])
trule(name="tr", dep=":lib")
config_setting(name="opt_cs", values={"compilation_mode":"opt"})
config_setting(name="def_cs", define_values={"FOO":"bar"})
filegroup(name="sel", srcs=select({":opt_cs":["x.txt"], ":def_cs":["y.txt"], "//conditions:default":["z.txt"]}))
genrule(name="gg", srcs=[":sel","@ext//lib:data"], outs=["gg.out"], cmd="cat $(SRCS) > $@ ; echo $(location :sel) >> $@", tools=["//b:tool"])
xlib(name="cl", srcs=["c.cc","c.h"], deps=[":cl2"])
xlib(name="cl2", srcs=["c2.cc"])
